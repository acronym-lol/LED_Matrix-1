[Unit]
Description=ACRONYM logo animation - three bouncing balls over jpeg-bridge
After=network.target jpeg-bridge.service
Requires=jpeg-bridge.service

[Service]
Type=simple
User=zongze
WorkingDirectory=/home/zongze/Documents/LED_Matrix-1
ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/python3 /home/zongze/Documents/LED_Matrix-1/python/three_bouncing_balls.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
